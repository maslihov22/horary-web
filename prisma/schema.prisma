// Horary — persistence.
//
// Serverless connection setup, per Supabase's Prisma guide: the runtime goes
// through Supavisor in transaction mode (port 6543, pgbouncer=true), while
// migrations need a session-mode connection (port 5432). Vercel's Supabase
// integration provides both, already shaped correctly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// A cast and judged horary. Stored so that a reading survives a reload, and
/// so that payment can be attached to one later.
///
/// There is no user table yet, deliberately. Access is by possession: the id is
/// an unguessable secret, and the browser that cast the reading also holds it in
/// an httpOnly cookie. A leaked link on its own opens nothing — the cookie is
/// what proves ownership. An email is recorded only if someone pays, because
/// that is the first moment a durable identity is actually needed.
model Reading {
  /// 24 chars from crypto.randomBytes — the secret that both addresses and
  /// unlocks the reading. At 62^24 the space is far past brute force.
  id String @id

  /// The querent's own words, and the house it was routed to.
  question String @db.Text
  house    Int

  /// The moment and place the figure was cast for. Both are part of the chart,
  /// not metadata: a different second or city yields a different judgment.
  askedAt    DateTime
  lat        Float
  lon        Float
  placeLabel String

  /// The engine's judgment, stored whole. `reasons` is the ordered list of
  /// testimonies; `chart` is what the drawing needs. Kept as JSON because they
  /// are read back as a unit and never queried across.
  verdict    String /// yes | no | qualified
  confidence Float
  reasons    Json
  timing     String?
  chart      Json

  /// The condition of both sides and what stands in the way — why the matter
  /// drags, who hinders it, on what terms it holds. Nullable because readings
  /// cast before the engine could read a planet's accidental condition have
  /// none, and a judgment already given is not re-judged to fit a later engine.
  circumstances Json?

  /// Significators, denormalised for display.
  querentPlanet  String
  querentSign    String
  querentDeg     Int
  querentMin     Int
  quesitedPlanet String
  quesitedSign   String
  quesitedDeg    Int
  quesitedMin    Int

  /// The written judgment. Withheld from the free view; `narration` is only
  /// served once paid.
  narration String  @db.Text
  fallback  Boolean @default(false)

  /// Payment. `email` arrives from Stripe's checkout session, not from a form.
  paid            Boolean   @default(false)
  paidAt          DateTime?
  email           String?
  stripeSessionId String?   @unique

  /// Claimed through the bot. The chat id comes from Telegram itself when the
  /// querent presses Start on a deep link carrying this reading's id — never
  /// from anything they typed. A username would be worthless here: it is
  /// self-declared, it changes, not everyone has one, and the Bot API cannot
  /// message a private chat by username at all.
  telegramChatId BigInt?
  claimedAt      DateTime?

  /// Grants the cookie to a browser arriving from the bot.
  ///
  /// A link sent to Telegram is proof of nothing on its own: the browser that
  /// opens it carries no evidence of who its owner is. So the bot appends a
  /// single-use token, and visiting with it mints the ownership cookie for that
  /// browser. Consumed on first use and reissued by the bot on demand, so a
  /// forwarded message cannot be replayed by whoever else reads it.
  accessToken   String?   @unique
  accessExpires DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([telegramChatId])
  @@index([createdAt])
  @@map("readings")
}
